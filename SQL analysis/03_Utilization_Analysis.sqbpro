<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="Medicare_Database_2.0.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure pragmas browser query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="4127"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Beneficiary_Table" custom_title="0" dock_id="1" table="4,17:mainBeneficiary_Table"/><dock_state state="000000ff00000000fd00000001000000020000012200000240fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000001220000013200ffffff000001220000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="Beneficiary_Table" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="175"/><column index="2" value="135"/><column index="3" value="87"/><column index="4" value="77"/><column index="5" value="60"/><column index="6" value="71"/><column index="7" value="167"/><column index="8" value="105"/><column index="9" value="133"/><column index="10" value="97"/><column index="11" value="98"/><column index="12" value="115"/><column index="13" value="107"/><column index="14" value="139"/><column index="15" value="126"/><column index="16" value="97"/><column index="17" value="152"/><column index="18" value="155"/><column index="19" value="96"/><column index="20" value="168"/><column index="21" value="176"/><column index="22" value="43"/><column index="23" value="40"/><column index="24" value="82"/><column index="25" value="161"/><column index="26" value="103"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="Overall Healthcare utilization">SELECT
	count(*) as total_Claims,
	count(DISTINCT Beneficiary_ID) as total_Beneficiaries_with_Claims,
	round(count(*) * 1.0 / count(DISTINCT Beneficiary_ID), 2) as avg_Claims_per_beneficiary
FROM Claims_Table
	
</sql><sql name="Utilization by claim type">SELECT
	Claim_Type,
	count(*) as total_Claims,
	count(DISTINCT Beneficiary_ID) as total_Beneficiaries_with_Claims,
	round(count(*) * 1.0 / count(DISTINCT Beneficiary_ID), 2) as avg_Claims_per_beneficiary,
	round(count(*) * 100.0 / sum(count(*)) OVER (), 2) as Percent_of_utilization
FROM Claims_Table
GROUP BY Claim_Type
</sql><sql name="Trend by year">SELECT
	strftime(&quot;%Y&quot;,Claim_Start_Date) as claim_Year,
	count(*) as total_Claims,
	count(DISTINCT Beneficiary_ID) as total_Beneficiaries_with_Claims,
	round(count(*) * 1.0 / count(DISTINCT Beneficiary_ID), 2) as avg_Claims_per_beneficiary
FROM Claims_Table
GROUP BY claim_Year

</sql><sql name="Beneficiary Utilization Distribution">WITH Beneficiary_Utilization as (
	SELECT 
		Beneficiary_ID,
		count(*) AS total_claims
	FROM Claims_Table
	GROUP BY Beneficiary_ID
	ORDER BY total_claims DESC)
	
SELECT 
	total_claims,
	count(*) as Beneficiary_Per_TotalClaims
FROM Beneficiary_Utilization
GROUP BY total_claims
ORDER BY Beneficiary_Per_TotalClaims DESC
 </sql><sql name="High-Utilization Beneficiaries*">WITH beneficiary_utilization AS (
    SELECT
        Beneficiary_ID,
        COUNT(*) AS total_claims
    FROM Claims_Table
    GROUP BY Beneficiary_ID
),

ranked_beneficiaries AS (
    SELECT
        Beneficiary_ID,
        total_claims,
        ROW_NUMBER() OVER (
            ORDER BY total_claims DESC
        ) AS beneficiary_rank
    FROM beneficiary_utilization
)

SELECT
    COUNT(*) AS top_10_percent_beneficiaries,
    SUM(total_claims) AS claims_generated_by_top_10_percent,
    ROUND(
        SUM(total_claims) * 100.0 /
        (SELECT COUNT(*) FROM Claims_Table),
        2
    ) AS percent_of_total_claims
FROM ranked_beneficiaries
WHERE beneficiary_rank &lt;= (SELECT count(DISTINCT Beneficiary_ID) * 0.1  from Claims_Table);</sql><current_tab id="4"/></tab_sql></sqlb_project>
