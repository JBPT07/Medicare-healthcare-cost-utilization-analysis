filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="Claim_Count_Rows">SELECT Claim_Type, count(Claim_ID) as total_claims
FROM Claims_Table
GROUP BY Claim_Type</sql><sql name="Beneficiary_Count_Rows">SELECT count(Beneficiary_ID) as total_Rows
FROM Beneficiary_Table
</sql><sql name="Beneficiary_Duplicates_Checks">SELECT Beneficiary_ID, count(Beneficiary_ID) as Total_Duplicates
FROM Beneficiary_Table
GROUP BY Beneficiary_Year_ID
HAVING Total_Duplicates &gt; 1</sql><sql name="Claim_Duplicates_Checks">SELECT Claim_ID, count(Claim_ID) as Total_Duplicates
FROM Claims_Table
GROUP BY Claim_ID
HAVING Total_Duplicates &gt; 1</sql><sql name="Claim_Null_Checks*">SELECT Claim_ID
FROM Claims_Table
WHERE Claim_ID is NULL</sql><sql name="Beneficiary_Null_Check*">SELECT Beneficiary_ID
FROM Beneficiary_Table
WHERE Beneficiary_ID IS NULL</sql><sql name="Dates_Values_Checks">Select 
	MAX(Claim_Start_Date) as Latest_Date,
	MIN(Claim_Start_Date) as Earliest_Date
FROM Claims_Table</sql><sql name="Beneficiary_W/O_Claims">SELECT c.Claim_ID, b.Beneficiary_ID
FROM Beneficiary_Table b
LEFT JOIN Claims_Table c
ON c.Beneficiary_ID = b.Beneficiary_ID
WHERE Claim_ID IS NULL
GROUP BY b.Beneficiary_ID

</sql><sql name="Claims_W/O_Beneficiaries">SELECT c.Claim_ID, b.Beneficiary_ID
FROM Claims_Table c
LEFT JOIN Beneficiary_Table b
ON b.Beneficiary_ID = c.Beneficiary_ID
WHERE b.Beneficiary_ID IS NULL</sql><sql name="Negative_Payment_Amount">SELECT 
	count(Claim_ID) as negative_claims,
	sum(Claim_Payment_Amount) as total_Negative_Amount,
	round(avg(Claim_Payment_Amount)) as avg_payment_Amount,
	min(Claim_Payment_Amount) as Most_Negative_Amount
FROM Claims_Table
WHERE Claim_Payment_Amount &lt; 0</sql><current_tab id="9"/></tab_sql></sqlb_project>
