<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="Medicare_Database_2.0.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="4127"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Beneficiary_Table" custom_title="0" dock_id="1" table="4,17:mainBeneficiary_Table"/><dock_state state="000000ff00000000fd00000001000000020000024200000203fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000002420000012d00ffffff000002420000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="Beneficiary_Table" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="12" mode="1"/></sort><column_widths><column index="1" value="171"/><column index="2" value="132"/><column index="3" value="85"/><column index="4" value="77"/><column index="5" value="59"/><column index="6" value="70"/><column index="7" value="163"/><column index="8" value="106"/><column index="9" value="131"/><column index="10" value="98"/><column index="11" value="99"/><column index="12" value="114"/><column index="13" value="107"/><column index="14" value="138"/><column index="15" value="124"/><column index="16" value="98"/><column index="17" value="149"/><column index="18" value="152"/><column index="19" value="95"/><column index="20" value="164"/><column index="21" value="175"/><column index="22" value="43"/><column index="23" value="40"/><column index="24" value="82"/><column index="25" value="163"/><column index="26" value="104"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="Chronic Condition Prevalence">WITH beneficiary_conditions AS (
    SELECT
        Beneficiary_ID,
        MAX(ESRD_Indicator) AS ESRD,
        MAX(Alzheimer_Indicator) AS Alzheimer,
        MAX(CHF_Indicator) AS CHF,
        MAX(CKD_Indicator) AS CKD,
        MAX(Cancer_Indicator) AS Cancer,
        MAX(COPD_Indicator) AS COPD,
        MAX(Depression_Indicator) AS Depression,
        MAX(Diabetes_Indicator) AS Diabetes,
        MAX(IHD_Indicator) AS IHD,
        MAX(Osteoporosis_Indicator) AS Osteoporosis,
        MAX(Osteoarthritis_Indicator) AS Osteoarthritis,
        MAX(TIA_Indicator) AS TIA
    FROM Beneficiary_Table
    GROUP BY Beneficiary_ID
),

condition_counts AS (
    SELECT 'ESRD' AS Chronic_Condition, SUM(ESRD) AS beneficiaries
    FROM beneficiary_conditions

	UNION ALL

    SELECT 'Alzheimer', SUM(Alzheimer)
    FROM beneficiary_conditions

    UNION ALL

    SELECT 'CHF', SUM(CHF)
    FROM beneficiary_conditions

    UNION ALL

    SELECT 'CKD', SUM(CKD)
    FROM beneficiary_conditions

    UNION ALL

    SELECT 'Cancer', SUM(Cancer)
    FROM beneficiary_conditions

    UNION ALL

    SELECT 'COPD', SUM(COPD)
    FROM beneficiary_conditions

    UNION ALL

    SELECT 'Depression', SUM(Depression)
    FROM beneficiary_conditions

    UNION ALL

    SELECT 'Diabetes', SUM(Diabetes)
    FROM beneficiary_conditions

    UNION ALL

    SELECT 'IHD', SUM(IHD)
    FROM beneficiary_conditions

    UNION ALL

    SELECT 'Osteoporosis', SUM(Osteoporosis)
    FROM beneficiary_conditions

    UNION ALL

    SELECT 'Osteoarthritis', SUM(Osteoarthritis)
    FROM beneficiary_conditions

    UNION ALL

    SELECT 'TIA', SUM(TIA)
    FROM beneficiary_conditions
)

SELECT
    Chronic_Condition,
    beneficiaries,
    ROUND(beneficiaries * 100.0 / (SELECT COUNT(*) FROM beneficiary_conditions),2) AS prevalence
FROM condition_counts
ORDER BY beneficiaries DESC;</sql><sql name="Utilization by Chronic Condition">WITH chronic_conditions AS (

    SELECT
        Beneficiary_Year_ID,
        'ESRD' AS Chronic_Condition
    FROM Beneficiary_Table
    WHERE ESRD_Indicator = 1

    UNION ALL

    SELECT
        Beneficiary_Year_ID,
        'Alzheimer'
    FROM Beneficiary_Table
    WHERE Alzheimer_Indicator = 1

    UNION ALL

    SELECT
        Beneficiary_Year_ID,
        'CHF'
    FROM Beneficiary_Table
    WHERE CHF_Indicator = 1

    UNION ALL

    SELECT
        Beneficiary_Year_ID,
        'CKD'
    FROM Beneficiary_Table
    WHERE CKD_Indicator = 1

    UNION ALL

    SELECT
        Beneficiary_Year_ID,
        'Cancer'
    FROM Beneficiary_Table
    WHERE Cancer_Indicator = 1

    UNION ALL

    SELECT
        Beneficiary_Year_ID,
        'COPD'
    FROM Beneficiary_Table
    WHERE COPD_Indicator = 1

    UNION ALL

    SELECT
        Beneficiary_Year_ID,
        'Depression'
    FROM Beneficiary_Table
    WHERE Depression_Indicator = 1

    UNION ALL

    SELECT
        Beneficiary_Year_ID,
        'Diabetes'
    FROM Beneficiary_Table
    WHERE Diabetes_Indicator = 1

    UNION ALL

    SELECT
        Beneficiary_Year_ID,
        'IHD'
    FROM Beneficiary_Table
    WHERE IHD_Indicator = 1

    UNION ALL

    SELECT
        Beneficiary_Year_ID,
        'Osteoporosis'
    FROM Beneficiary_Table
    WHERE Osteoporosis_Indicator = 1

    UNION ALL

    SELECT
        Beneficiary_Year_ID,
        'Osteoarthritis'
    FROM Beneficiary_Table
    WHERE Osteoarthritis_Indicator = 1

    UNION ALL

    SELECT
        Beneficiary_Year_ID,
        'TIA'
    FROM Beneficiary_Table
    WHERE TIA_Indicator = 1
)

SELECT
    cc.Chronic_Condition,

    COUNT(DISTINCT cc.Beneficiary_Year_ID)
        AS Total_Beneficiary_Years,

    COUNT(c.Claim_ID)
        AS Total_Claims,

    ROUND(
        COUNT(c.Claim_ID) * 1.0 /
        COUNT(DISTINCT cc.Beneficiary_Year_ID),
        2
    ) AS Claims_Per_Beneficiary_Year,

    SUM(c.Claim_Payment_Amount)
        AS Total_Cost,

    ROUND(
        SUM(c.Claim_Payment_Amount) * 1.0 /
        COUNT(DISTINCT cc.Beneficiary_Year_ID),
        2
    ) AS Cost_Per_Beneficiary_Year,

    ROUND(
        SUM(c.Claim_Payment_Amount) * 1.0 /
        COUNT(c.Claim_ID),
        2
    ) AS Cost_Per_Claim,

    ROUND(
        SUM(c.Claim_Payment_Amount) * 100.0 /
        (SELECT SUM(Claim_Payment_Amount)
         FROM Claims_Table),
        2
    ) AS Cost_Percent,

    ROUND(
        COUNT(c.Claim_ID) * 100.0 /
        (SELECT COUNT(*)
         FROM Claims_Table),
        2
    ) AS Claims_Condition_Percent

FROM chronic_conditions cc

LEFT JOIN Claims_Table c
    ON c.Beneficiary_Year_ID = cc.Beneficiary_Year_ID

GROUP BY
    cc.Chronic_Condition

ORDER BY
    Total_Cost DESC;</sql><current_tab id="1"/></tab_sql></sqlb_project>
